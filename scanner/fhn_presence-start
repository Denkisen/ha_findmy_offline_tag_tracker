#!/bin/sh
# fhn_presence-start — run the raw-BLE Loshall Tag presence scanner.
#
# First run creates a local venv and installs requirements; afterwards it
# just execs the scanner. Configuration comes from fhn_presence.env in the
# same directory (see the env file for the variable list).
set -eu

DIR="$(cd "$(dirname "$0")" && pwd)"

if [ ! -x "$DIR/venv/bin/python" ]; then
    echo "first run: creating venv in $DIR/venv" >&2
    python3 -m venv "$DIR/venv"
    "$DIR/venv/bin/pip" install --no-cache-dir -r "$DIR/requirements.txt"
fi

set -a
. "$DIR/fhn_presence.env"
set +a

export PYTHONPATH="$DIR${PYTHONPATH:+:$PYTHONPATH}"
exec "$DIR/venv/bin/python" -m scanner.fhn_presence "$@"

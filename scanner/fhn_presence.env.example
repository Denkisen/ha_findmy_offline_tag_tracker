# fhn_presence.env — scanner configuration (NO key material in VCS; fill in).
#
# Beacon key material: copy the values from your fhn_track.py
# (clock offset + Ephemeral Identity Key + curve).

FHN_TAG_NAME="Loshall Tag"
FHN_TAG_EIK="<paste the 64-hex Ephemeral Identity Key>"
FHN_TAG_CLOCK_OFFSET="<paste the clock offset float>"
FHN_TAG_CURVE="secp160r1"

# Presence thresholds (seconds).
# normal: silence allowed between rotations — must exceed the beacon's
# rotation silence (observed 148s and slowly growing with its clock drift).
FHN_NORMAL_THRESHOLD="200"
# rotation: silence allowed right after a MAC change (rotation).
FHN_ROTATION_THRESHOLD="400"

# MQTT broker (install the "MQTT broker" add-on in HA first).
FHN_MQTT_URL="mqtt://127.0.0.1:1883"
FHN_MQTT_USER="<add-on user>"
FHN_MQTT_PASS="<add-on password>"
# Optional: fixed entity id (default: random).
#FHN_MQTT_UNIQUE_ID="losall_tag_presence"
FHN_MQTT_BASE_TOPIC="fhn/losall_tag"

FHN_LOG_LEVEL="INFO"

# fhn_presence.service — systemd unit for the raw-BLE Loshall Tag scanner.
#
# Install:
#   install -D scanner/fhn_presence.service /etc/systemd/system/fhn_presence.service
#   systemctl enable --now fhn_presence
#
# The unit assumes the scanner files live in /opt/fhn_presence (zip,
# requirements.txt, fhn_presence.env) and a venv at /opt/fhn_presence/venv
# (created by fhn_presence-start on first run, or pre-built).
[Unit]
Description=FHN Loshall Tag raw-BLE presence scanner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/fhn_presence
EnvironmentFile=/opt/fhn_presence/fhn_presence.env
Environment=PYTHONPATH=/opt/fhn_presence
ExecStart=/opt/fhn_presence/venv/bin/python -m scanner.fhn_presence
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
